{
  "schemaVersion": 1,
  "id": "musicplayer",
  "version": "${version}",
  "name": "Music Player — Unofficial 26.x Port",
  "description": "Unofficial Fabric port of Music Player 2.7.1.351 for Minecraft 26.1 through 26.2.",
  "authors": [
    "HyCraftHD"
  ],
  "contributors": [
    "misaki-schulz — Minecraft 26.x port"
  ],
  "contact": {
    "homepage": "https://github.com/misaki-schulz/Music-Player-port",
    "sources": "https://github.com/misaki-schulz/Music-Player-port",
    "issues": "https://github.com/misaki-schulz/Music-Player-port/issues"
  },
  "license": "Apache-2.0",
  "icon": "logo.png",
  "environment": "client",
  "mixins": [
    "musicplayer.mixins.json"
  ],
  "entrypoints": {
    "client": [
      "info.u_team.music_player.MusicPlayerMod"
    ],
    "modmenu": [
      "info.u_team.music_player.integration.MusicPlayerModMenu"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_min_version}",
    "fabric-api": ">=${fabric_api_min_version}",
    "modmenu": "*",
    "minecraft": "${minecraft_dependency}",
    "java": ">=25"
  }
}
